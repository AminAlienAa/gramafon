{
  "name": "gramafon-desktop",
  "productName": "Gramafon",
  "version": "1.0.0",
  "description": "گرامافون: پخش پلی‌لیست ساندکلود و اسپاتیفای",
  "author": "Alienam",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
"devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.gramafon.desktop",
    "productName": "Gramafon",
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "config.json", "offline.html", "build/icon.png"],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "گرامافون",
      "artifactName": "Gramafon-Setup-${version}.exe"
    }
  }
}
